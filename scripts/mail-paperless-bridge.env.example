# mail-paperless-bridge — nach /opt/paperless-scripts/mail-paperless-bridge.env kopieren
# chmod 600 /opt/paperless-scripts/mail-paperless-bridge.env
#
# Siehe docs/MAIL_PAPERLESS_BRIDGE.md

# IMAP (gleicher Account wie Mail Helper, eigener Ordner «Paperless»)
MAIL_BRIDGE_IMAP_HOST=imap.gmx.net
MAIL_BRIDGE_IMAP_PORT=993
MAIL_BRIDGE_IMAP_SSL=true
MAIL_BRIDGE_IMAP_USER=thomas.santinelli@gmx.ch
MAIL_BRIDGE_IMAP_PASSWORD=geheim

# Quellordner (Mails hierhin — Mail-Helper-Regel oder manuell)
MAIL_BRIDGE_IMAP_FOLDER=Paperless

# Nach Export: dorthin verschieben (leer = nur als gelesen markieren)
MAIL_BRIDGE_IMAP_EXPORT_FOLDER=Paperless/Exportiert

# Paperless consume (CT 121)
MAIL_BRIDGE_CONSUME_DIR=/mnt/paperless-data/consume

# Verarbeitete UIDs (unter /opt/paperless-scripts/state/)
MAIL_BRIDGE_STATE_FILE=/opt/paperless-scripts/state/mail-paperless-bridge.json

# Inline-Bilder (Logos in Signaturen) nicht als Anhang
MAIL_BRIDGE_SKIP_INLINE=true

# Nach Erfolg: gelesen markieren (wenn kein Export-Ordner)
MAIL_BRIDGE_MARK_SEEN=true

# Quelle löschen ohne Export-Ordner (selten nötig)
MAIL_BRIDGE_DELETE_AFTER=false

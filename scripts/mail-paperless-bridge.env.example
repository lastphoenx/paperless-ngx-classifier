# mail-paperless-bridge — nach /etc/mail-paperless-bridge.env kopieren, chmod 600
#
# IMAP (gleicher Account wie Mail Helper, eigener Ordner «Paperless»)
MAIL_BRIDGE_IMAP_HOST=imap.gmx.net
MAIL_BRIDGE_IMAP_PORT=993
MAIL_BRIDGE_IMAP_SSL=true
MAIL_BRIDGE_IMAP_USER=thomas.santinelli@gmx.ch
MAIL_BRIDGE_IMAP_PASSWORD=geheim

# Quellordner (Mails hierhin legen / per Mail-Helper-Regel verschieben)
MAIL_BRIDGE_IMAP_FOLDER=Paperless

# Nach Export: Kopie hierhin (leer lassen = nur als gelesen markieren)
MAIL_BRIDGE_IMAP_EXPORT_FOLDER=Paperless/Exportiert

# Paperless consume (CT 121)
MAIL_BRIDGE_CONSUME_DIR=/mnt/paperless-data/consume

# Verarbeitete UIDs merken (Duplikate vermeiden)
MAIL_BRIDGE_STATE_FILE=/var/lib/mail-paperless-bridge/state.json

# Inline-Bilder (Logos in Signaturen) nicht als Anhang
MAIL_BRIDGE_SKIP_INLINE=true

# Nach Erfolg: gelesen markieren (empfohlen)
MAIL_BRIDGE_MARK_SEEN=true

# Quelle löschen statt nur kopieren (nur wenn EXPORT_FOLDER gesetzt)
MAIL_BRIDGE_DELETE_AFTER=false
